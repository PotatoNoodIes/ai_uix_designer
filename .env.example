# ──────────────────────────────────────────────
# UIX AI Agent — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real keys.

# ─── SERVER-ONLY (read at runtime by the Bun API, never sent to the browser) ──
# These must NOT be prefixed with VITE_. Anything VITE_-prefixed is compiled
# into the public JS bundle and is readable by anyone who loads the site.

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Clerk secret key, used to verify session tokens server-side.
# https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Upstash Redis — usage quotas. https://console.upstash.com → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── PUBLIC (compiled into the browser bundle — safe by design) ───────────────
# Clerk's publishable key is meant to be public.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ─── OPTIONAL ────────────────────────────────────────────────────────────────
# OpenRouter is only reachable through a user's own key, entered in the app's
# Settings dialog. There is no server-side OpenRouter key.
